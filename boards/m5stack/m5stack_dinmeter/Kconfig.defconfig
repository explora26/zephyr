if BOARD_M5STACK_DINMETER_ESP32S3_PROCPU

config KERNEL_MEM_POOL
	default y

if LVGL

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_16
endchoice

config LV_COLOR_16_SWAP
	default y

endif # LVGL

endif # BOARD_M5STACK_DINMETER_ESP32S3_PROCPU
