if BOARD_MINI_STM32H743_STM32H743XX_EXT_FLASH_APP

choice BOOTLOADER
	default BOOTLOADER_MCUBOOT
endchoice

choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_NONE
endchoice

choice MCUBOOT_MODE
	default MCUBOOT_MODE_SWAP_USING_OFFSET
endchoice

endif # BOARD_MINI_STM32H743_STM32H743XX_EXT_FLASH_APP
