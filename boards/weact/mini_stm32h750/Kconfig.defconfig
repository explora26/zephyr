if BOARD_MINI_STM32H750

if DISPLAY

config INPUT
	default y

if LVGL

config LV_COLOR_16_SWAP
	default y

config LV_Z_BITS_PER_PIXEL
	default 16

endif # LVGL

endif # DISPLAY

source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

endif # BOARD_MINI_STM32H750
